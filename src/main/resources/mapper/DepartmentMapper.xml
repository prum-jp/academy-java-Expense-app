<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.expenseapp.mapper.DepartmentMapper">

    <resultMap id="departmentMap" type="com.example.expenseapp.entity.Department">
        <id column="dept_id" property="deptId"/>
        <result column="dept_name" property="deptName"/>
    </resultMap>

    <select id="findById" resultMap="departmentMap">
        SELECT dept_id, dept_name
        FROM departments
        WHERE dept_id = #{deptId}
    </select>

    <select id="findAll" resultMap="departmentMap">
        SELECT dept_id, dept_name
        FROM departments
        ORDER BY dept_id
    </select>
</mapper>
